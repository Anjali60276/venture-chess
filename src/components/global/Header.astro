---
import MagneticButton from '../ui/MagneticButton.astro';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Results', href: '/chess-student-achievements/' },
  { label: 'Courses', href: '/chess-academy-karnataka-india/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'VCA Games', href: '/vca-free-mini-games/' },
  { label: 'Contact', href: '/contact-us/' },
];
---

<header class="header reveal-fade-up">
  <div class="header-container">
    <a href="/" class="logo-link">
      <img 
        src="https://venturechessacademy.com/wp-content/uploads/2025/04/Venture-Chess-Academy.png" 
        alt="Venture Chess Academy" 
        class="logo-image" 
      />
    </a>

    <nav class="desktop-nav">
      <ul class="nav-list">
        <span class="nav-indicator" aria-hidden="true"></span>
        {navItems.map(item => (
          <li>
            <a href={item.href} class="nav-link has-slideup-anim">
              <span class="nav-link-text" data-text={item.label}>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <MagneticButton 
        href="https://classroom.venturechessacademy.com/login?_gl=1*g9sg7d*_ga*MTAwMjI4ODMyNy4xNzY5NDk1OTE0*_ga_1CJMJETPZP*czE3ODg4MzYxMDIkbzk1JGcxJHQxNzg4ODM2MTgyJGo2MCRsMCRoMA.." 
        text="My Classroom" 
        variant="primary" 
        className="header-cta"
      />
      <button class="mobile-menu-toggle" aria-label="Toggle menu">
        <span class="hamburger"></span>
      </button>
    </div>
  </div>

  <!-- Fullscreen Mobile Menu -->
  <div class="mobile-menu">
    <div class="mobile-menu-inner">
      <ul class="mobile-nav-list">
        {navItems.map(item => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.label}</a>
          </li>
        ))}
        <li>
          <a href="https://classroom.venturechessacademy.com/login?_gl=1*g9sg7d*_ga*MTAwMjI4ODMyNy4xNzY5NDk1OTE0*_ga_1CJMJETPZP*czE3ODg4MzYxMDIkbzk1JGcxJHQxNzg4ODM2MTgyJGo2MCRsMCRoMA.." class="mobile-nav-link text-primary">My Classroom</a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 1rem;
    left: 0;
    width: 100%;
    z-index: 100;
    pointer-events: none;
    transition: transform 0.3s var(--ease-out);
  }

  .header.is-scrolled {
    transform: translateY(-0.5rem);
  }

  .header-container {
    pointer-events: auto;
    max-width: 1200px;
    width: 95%;
    margin: 0 auto;
    padding: 0.75rem 0.75rem 0.75rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #fcfaf7;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.03);
    transition: all 0.3s var(--ease-out);
  }

  .header.is-scrolled .header-container {
    background-color: rgba(252, 250, 247, 0.9);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .logo-link {
    display: flex;
    align-items: center;
    width: auto;
    position: relative;
    z-index: 101;
  }

  .logo-image {
    height: 48px;
    width: auto;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (hover: hover) {
    .logo-link:hover .logo-image,
    .logo-link:focus-visible .logo-image {
      transform: rotate(12deg) scale(1.08);
    }
  }

  .logo-link:focus-visible .logo-image {
    transform: rotate(12deg) scale(1.08);
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
      background-color: rgba(0, 0, 0, 0.04);
      border-radius: var(--radius-pill);
      padding: 0.6rem 1.2rem;
    }
    .logo-image {
      height: 58px;
    }
  }

  .nav-list {
    display: flex;
    gap: 1.8rem;
    align-items: center;
    position: relative;
    padding-bottom: 2px;
  }

  .nav-indicator {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    border-radius: 999px;
    background-color: var(--color-primary);
    pointer-events: none;
    z-index: 2;
    width: var(--highlight-width, 0px);
    opacity: var(--highlight-opacity, 0);
    transform: translateX(var(--highlight-left, 0px));
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
  }

  .nav-link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--color-text-light);
    position: relative;
    padding: 0.3rem 0.6rem;
    transition: color 0.3s var(--ease-out);
    z-index: 1;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  /* Slide-up text animation for remaining nav links (Blog, VCA Games, Contact) */
  .nav-link.has-slideup-anim {
    overflow: hidden;
    display: inline-block;
    vertical-align: middle;
  }

  .nav-link.has-slideup-anim .nav-link-text {
    display: inline-block;
    position: relative;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .nav-link.has-slideup-anim .nav-link-text::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    white-space: nowrap;
    color: var(--color-primary);
  }

  @media (hover: hover) {
    .nav-link.has-slideup-anim:hover .nav-link-text,
    .nav-link.has-slideup-anim:focus-visible .nav-link-text {
      transform: translateY(-100%);
    }
  }

  .nav-link.has-slideup-anim:focus-visible .nav-link-text {
    transform: translateY(-100%);
  }

  /* My Classroom CTA Animations */
  :global(.header-cta .btn-text) {
    display: inline-grid !important;
    grid-template-areas: "stack" !important;
    align-items: center !important;
    justify-items: center !important;
    overflow: hidden !important;
  }

  :global(.header-cta-default),
  :global(.header-cta-hover),
  :global(.header-cta-launching) {
    grid-area: stack !important;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s ease !important;
    white-space: nowrap !important;
  }

  :global(.header-cta-default) {
    transform: translateY(0) !important;
    opacity: 1 !important;
    text-transform: uppercase !important;
  }

  :global(.header-cta-hover) {
    transform: translateY(120%) !important;
    opacity: 0 !important;
    text-transform: none !important;
  }

  :global(.header-cta-launching) {
    transform: translateY(120%) !important;
    opacity: 0 !important;
    text-transform: none !important;
  }

  @media (hover: hover) {
    :global(.header-cta:hover:not(.is-launching) .header-cta-default),
    :global(.header-cta:focus-visible:not(.is-launching) .header-cta-default) {
      transform: translateY(-120%) !important;
      opacity: 0 !important;
    }

    :global(.header-cta:hover:not(.is-launching) .header-cta-hover),
    :global(.header-cta:focus-visible:not(.is-launching) .header-cta-hover) {
      transform: translateY(0) !important;
      opacity: 1 !important;
    }
  }

  /* Launching state */
  :global(.header-cta.is-launching .header-cta-default),
  :global(.header-cta.is-launching .header-cta-hover) {
    transform: translateY(-120%) !important;
    opacity: 0 !important;
  }

  :global(.header-cta.is-launching .header-cta-launching) {
    transform: translateY(0) !important;
    opacity: 1 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-indicator {
      transition: none !important;
    }

    .nav-link.has-slideup-anim .nav-link-text {
      transition: none !important;
    }

    .nav-link.has-slideup-anim:hover .nav-link-text,
    .nav-link.has-slideup-anim:focus-visible .nav-link-text {
      transform: none !important;
    }

    :global(.header-cta-default),
    :global(.header-cta-hover),
    :global(.header-cta-launching) {
      transition: none !important;
    }

    .logo-image {
      transition: none !important;
    }

    .logo-link:hover .logo-image,
    .logo-link:focus-visible .logo-image {
      transform: none !important;
    }
  }

  /* Make header CTA button responsive */
  :global(.header-cta) {
    padding: 0.6rem 1.2rem !important;
    font-size: 0.85rem !important;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 101;
  }

  @media (min-width: 768px) {
    :global(.header-cta) {
      padding: 1.2rem 3rem !important;
      font-size: 1.1rem !important;
    }
    
    .header-actions {
      gap: 1.5rem;
    }
  }

  /* Hamburger Menu */
  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-surface);
  }

  @media (min-width: 1024px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .hamburger {
    position: relative;
    width: 20px;
    height: 2px;
    background-color: currentColor;
    transition: background-color 0.3s;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transition: transform 0.3s var(--ease-out);
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    bottom: -6px;
  }

  .mobile-menu-toggle.is-active .hamburger {
    background-color: transparent;
  }

  .mobile-menu-toggle.is-active .hamburger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-toggle.is-active .hamburger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Menu Overlay */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-bg);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: circle(0% at top right);
    transition: clip-path 0.6s var(--ease-spring);
    pointer-events: none;
  }

  .mobile-menu.is-active {
    clip-path: circle(150% at top right);
    pointer-events: all;
  }

  .mobile-nav-list {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .text-primary {
    color: var(--color-primary);
  }

  .mobile-menu.is-active .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger delays for menu items */
  .mobile-menu.is-active .mobile-nav-list li:nth-child(1) .mobile-nav-link { transition-delay: 0.1s; }
  .mobile-menu.is-active .mobile-nav-list li:nth-child(2) .mobile-nav-link { transition-delay: 0.15s; }
  .mobile-menu.is-active .mobile-nav-list li:nth-child(3) .mobile-nav-link { transition-delay: 0.2s; }
  .mobile-menu.is-active .mobile-nav-list li:nth-child(4) .mobile-nav-link { transition-delay: 0.25s; }
  .mobile-menu.is-active .mobile-nav-list li:nth-child(5) .mobile-nav-link { transition-delay: 0.3s; }
  .mobile-menu.is-active .mobile-nav-list li:nth-child(6) .mobile-nav-link { transition-delay: 0.35s; }
  .mobile-menu.is-active .mobile-nav-list li:nth-child(7) .mobile-nav-link { transition-delay: 0.4s; }
  .mobile-menu.is-active .mobile-nav-list li:nth-child(8) .mobile-nav-link { transition-delay: 0.45s; }

</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll effect
    const header = document.querySelector('.header');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header?.classList.add('is-scrolled');
      } else {
        header?.classList.remove('is-scrolled');
      }
    });

    // Mobile Menu Toggle
    const menuToggle = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.querySelector('.mobile-menu');
    
    menuToggle?.addEventListener('click', () => {
      menuToggle.classList.toggle('is-active');
      mobileMenu?.classList.toggle('is-active');
      
      // Prevent body scroll when menu is open
      if (mobileMenu?.classList.contains('is-active')) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    // 1) Sliding Hover Indicator (desktop 1024px and up)
    const navList = document.querySelector('.nav-list') as HTMLElement | null;
    const navLinks = document.querySelectorAll('.nav-link');
    let activeLink: HTMLElement | null = null;

    if (navList) {
      const updateIndicator = (el: HTMLElement) => {
        activeLink = el;
        navList.style.setProperty('--highlight-left', `${el.offsetLeft}px`);
        navList.style.setProperty('--highlight-width', `${el.offsetWidth}px`);
        navList.style.setProperty('--highlight-opacity', '1');
      };

      navLinks.forEach(link => {
        const htmlLink = link as HTMLElement;
        htmlLink.addEventListener('mouseenter', () => updateIndicator(htmlLink));
        htmlLink.addEventListener('focusin', () => updateIndicator(htmlLink));
      });

      navList.addEventListener('mouseleave', () => {
        activeLink = null;
        navList.style.setProperty('--highlight-opacity', '0');
      });

      navList.addEventListener('focusout', (e: FocusEvent) => {
        if (!navList.contains(e.relatedTarget as Node | null)) {
          activeLink = null;
          navList.style.setProperty('--highlight-opacity', '0');
        }
      });

      let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('resize', () => {
        if (resizeTimeout) clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          if (activeLink) {
            updateIndicator(activeLink);
          }
        }, 100);
      });
    }

    // 2) & 3) My Classroom Text Morph and Click Animation
    const ctaBtn = document.querySelector('.header-cta') as HTMLAnchorElement | null;
    if (ctaBtn) {
      const btnText = ctaBtn.querySelector('.btn-text');
      if (btnText && !btnText.querySelector('.header-cta-default')) {
        const defaultText = btnText.textContent?.trim() || 'MY CLASSROOM';
        btnText.innerHTML = `
          <span class="header-cta-default">${defaultText}</span>
          <span class="header-cta-hover" aria-hidden="true">Go to Classroom &rarr;</span>
          <span class="header-cta-launching" aria-hidden="true">&check; Launching...</span>
        `;
      }

      ctaBtn.addEventListener('click', (e: MouseEvent) => {
        if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) {
          return;
        }

        e.preventDefault();
        ctaBtn.classList.add('is-launching');
        const href = ctaBtn.getAttribute('href');
        const target = ctaBtn.getAttribute('target');

        setTimeout(() => {
          if (href) {
            if (target === '_blank') {
              window.open(href, '_blank');
              ctaBtn.classList.remove('is-launching');
            } else {
              window.location.href = href;
            }
          }
        }, 700);
      });

      window.addEventListener('pageshow', (event: PageTransitionEvent) => {
        if (event.persisted) {
          ctaBtn.classList.remove('is-launching');
        }
      });
    }
  });
</script>
