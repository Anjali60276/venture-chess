---
import { faqs } from '../../data/faqs';
---

<section class="section faq-section">
  <div class="container">
    <div class="section-header reveal-fade-up">
      <h2 class="text-h1 title">Your top questions<br/>answered with a smile</h2>
      <p>Here you can find answers to frequently asked questions about our programs and services.</p>
    </div>

    <div class="faq-accordion reveal-fade-up" style="transition-delay: 0.2s;">
      {faqs.map((faq, index) => (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span class="question-text">{faq.question}</span>
            <span class="faq-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </button>
          <div class="faq-answer">
            <div class="answer-inner">
              <p>{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: var(--color-surface);
  }

  

  .title {
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .faq-accordion {
    max-width: 800px;
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    text-align: left;
    color: var(--color-primary);
  }

  .question-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    padding-right: 2rem;
  }

  .faq-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    transition: transform 0.4s var(--ease-spring);
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(45deg);
    color: var(--color-secondary);
  }

  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s var(--ease-spring);
  }

  .faq-question[aria-expanded="true"] + .faq-answer {
    grid-template-rows: 1fr;
  }

  .answer-inner {
    overflow: hidden;
  }

  .answer-inner p {
    padding-bottom: 2rem;
    margin: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const questions = document.querySelectorAll('.faq-question');
    
    questions.forEach(question => {
      question.addEventListener('click', () => {
        const isExpanded = question.getAttribute('aria-expanded') === 'true';
        
        // Optional: Close others
        questions.forEach(q => {
          q.setAttribute('aria-expanded', 'false');
        });

        if (!isExpanded) {
          question.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>
