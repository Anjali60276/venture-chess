---
import { courses } from "../../data/courses";
import MagneticButton from "../ui/MagneticButton.astro";
---

<section class="section curriculum-section">
  <div class="container">
    <div class="curriculum-header reveal-fade-up">
      <h2 class="text-display title">SYLLABUS</h2>
      <MagneticButton
        href="/chess-academy-karnataka-india/"
        text="View All Courses"
        variant="primary"
      />
    </div>

    <div class="courses-grid">
      {
        courses.map((course, index) => (
          <div
            class={`course-card hover-lift reveal-fade-up ${index % 2 !== 0 ? "offset-card" : ""}`}
            style={`transition-delay: ${(index % 2) * 0.1}s;`}
          >
            <div
              class="course-image hover-image-zoom"
              data-cursor-text="EXPLORE"
            >
              <img src={course.image} alt={course.name} />
            </div>
            <div class="course-content">
              <div class="course-level">LEVEL 0{index + 1}</div>
              <h3 class="course-name">{course.name}</h3>
              <p class="course-desc">{course.description}</p>
              <a
                href={`/chess-academy-karnataka-india/#${course.id}`}
                class="course-link"
              >
                JOIN NOW <span class="arrow">→</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .curriculum-section {
    padding: 8rem 0;
    background-color: var(--color-bg);
  }

  .curriculum-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 6rem;
  }

  @media (min-width: 768px) {
    .curriculum-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .title {
    color: var(--color-primary);
    font-size: clamp(2rem, 5vw, 4rem);
  }

  .courses-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem 2rem;
  }

  @media (min-width: 768px) {
    .courses-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .offset-card {
      margin-top: 0;
    }
  }

  .course-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-2xl);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .course-image {
    width: 100%;
    height: 300px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .course-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .course-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
  }

  .course-level {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  .course-name {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .course-desc {
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .course-link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
  }

  .course-link .arrow {
    transition: transform 0.3s var(--ease-out);
  }

  .course-link:hover .arrow {
    transform: translateX(5px);
  }
</style>
