---
import MagneticButton from "../ui/MagneticButton.astro";
---

<section class="hero-section">
  <!-- Full-bleed responsive background artwork banner layer (z-index: 0) -->
  <div class="hero-bg-wrapper">
    <picture class="hero-bg-picture">
      <source
        media="(min-width: 1024px)"
        srcset="/images/hero/hero-desktop.png"
      />
      <source
        media="(min-width: 640px)"
        srcset="/images/hero/hero-tablet.png"
      />
      <img
        src="/images/hero/hero-mobile.png"
        alt="Venture Chess Academy - Online Chess Training for Kids"
        class="hero-bg-img"
        width="841"
        height="1870"
        decoding="async"
        fetchpriority="high"
        loading="eager"
      />
    </picture>
    <!-- Readability gradient overlay -->
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-wrapper">
        <!-- Orange Crown Doodle above badge (Desktop only) -->
        <svg
          class="doodle-crown"
          width="36"
          height="28"
          viewBox="0 0 36 28"
          fill="none"
          stroke="#d4621c"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 22L2 8L10 14L18 4L26 14L34 8L32 22H4Z"></path>
          <circle cx="18" cy="4" r="1.5" fill="#d4621c"></circle>
        </svg>

        <div class="hero-badge reveal-fade-up">
          <svg
            class="badge-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"
            ></path>
          </svg>
          Bringing Love for Chess
        </div>
      </div>

      <div class="title-wrapper">
        <h1 class="hero-title reveal-fade-up">
          <span class="title-dark">Online Chess Training</span>
          <span class="title-orange">for Kids from Age 3+</span>
        </h1>

        <!-- Orange Lightbulb Doodle top-right of headline (Desktop only) -->
        <svg
          class="doodle-bulb"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#d4621c"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M9 18h6M10 22h4M12 2a7 7 0 0 0-7 7c0 2.5 1.3 4.7 3.3 6C9 15.8 9 17 9 18h6c0-1 0-2.2.7-3 2-1.3 3.3-3.5 3.3-6a7 7 0 0 0-7-7z"
          ></path>
        </svg>

        <!-- Hand-drawn orange underline under headline -->
        <svg
          class="headline-underline"
          viewBox="0 0 250 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3 14C50 4 150 4 247 14"
            stroke="#d4621c"
            stroke-width="4"
            stroke-linecap="round"></path>
        </svg>
      </div>

      <div class="hero-actions reveal-fade-up" style="transition-delay: 0.2s;">
        <div class="cta-wrapper">
          <a href="/appointment/" class="custom-hero-btn" data-magnetic>
            <span class="btn-text">Join Free Session &rarr;</span>
            <span class="btn-bg"></span>
          </a>

          <!-- Orange Heart Doodle near button (Desktop only) -->
          <svg
            class="doodle-heart"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#d4621c"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
            ></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding-top: 140px;
    padding-bottom: 5rem;
    overflow: hidden;
    background-color: #fffcf9;
  }

  @media (max-width: 767px) {
    .hero-section {
      padding-bottom: 25rem;
    }
  }

  /* Full-bleed background image container layer */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero-bg-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-bg-img {
    display: block;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center bottom;
  }

  @media (min-width: 640px) {
    .hero-bg-img {
      object-position: center center;
    }
  }

  @media (min-width: 1024px) {
    .hero-bg-img {
      object-position: right center;
    }
  }

  /* Readability gradient overlay */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to right,
      #fffcf959 0%,
      #fffcf945 45%,
      #fffcf91c 80%
    );
  }

  @media (max-width: 1023px) {
    .hero-overlay {
      background: linear-gradient(
        to right,
        #fffcf959 0%,
        #fffcf945 45%,
        #fffcf91c 80%
      );
    }
  }

  /* Hero Content Container Layer */
  .hero-container {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .hero-content {
    max-width: 100%;
  }

  @media (min-width: 1024px) {
    .hero-content {
      max-width: 720px;
    }
  }

  @media (max-width: 1023px) {
    .hero-content {
      text-align: center;
      margin: 0 auto;
    }
  }

  /* Badge styling */
  .hero-badge-wrapper {
    position: relative;
    display: inline-block;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #f7dac4;
    color: #a04910;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 10px rgba(160, 73, 16, 0.12);
    transform: rotate(-2deg);
    border: 2px dashed rgba(160, 73, 16, 0.3);
  }

  @media (max-width: 1023px) {
    .hero-badge {
      margin: 0 auto 2rem;
      transform: none;
    }
  }

  .badge-icon {
    width: 20px;
    height: 20px;
  }

  /* Title styling */
  .title-wrapper {
    position: relative;
    display: inline-block;
    width: 100%;
  }

  .hero-title {
    font-size: clamp(2rem, 3.2vw + 0.5rem, 3.8rem);
    line-height: 1.12;
    margin-bottom: 2rem;
    position: relative;
    z-index: 2;
    font-weight: 800;
  }

  .title-dark {
    display: block;
    color: var(--color-primary);
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
  }

  .title-orange {
    display: block;
    color: #d4621c;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
  }

  @media (min-width: 1024px) {
    .title-dark,
    .title-orange {
      white-space: nowrap;
    }
  }

  /* Hand-drawn Underline SVG */
  .headline-underline {
    width: 220px;
    height: 16px;
    display: block;
    margin-top: -1.2rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 1023px) {
    .headline-underline {
      margin: -1.2rem auto 2.5rem auto;
    }
  }

  /* Actions & Button */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  @media (max-width: 1023px) {
    .hero-actions {
      justify-content: center;
    }
  }

  .cta-wrapper {
    position: relative;
    display: inline-block;
  }

  .custom-hero-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 3rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-surface);
    overflow: hidden;
    z-index: 1;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(89, 34, 24, 0.25);
    text-decoration: none;
  }

  .custom-hero-btn .btn-text {
    position: relative;
    z-index: 2;
    transition: transform 0.3s var(--ease-out);
    display: inline-block;
  }

  .custom-hero-btn .btn-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-pill);
    background-color: var(--color-primary);
    z-index: -1;
    transition: transform 0.4s var(--ease-spring);
  }

  .custom-hero-btn:hover .btn-bg {
    transform: scale(1.05);
  }

  /* Desktop Doodles (Crown, Lightbulb, Heart) */
  .doodle-crown,
  .doodle-bulb,
  .doodle-heart {
    display: none;
    position: absolute;
    pointer-events: none;
    opacity: 0.9;
    z-index: 4;
  }

  @media (min-width: 1024px) {
    .doodle-crown {
      display: block;
      top: -24px;
      left: 12px;
      transform: rotate(-10deg);
    }

    .doodle-bulb {
      display: block;
      top: 10px;
      right: 20px;
      transform: rotate(12deg);
    }

    .doodle-heart {
      display: block;
      bottom: -15px;
      right: -25px;
      transform: rotate(15deg);
    }
  }
</style>
