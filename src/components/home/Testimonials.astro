---
import { testimonials } from '../../data/testimonials';
---

<section class="section testimonials-section">
  <div class="container">
    <div class="testimonials-header reveal-fade-up">
      <h6 class="subtitle">OUR TESTIMONIALS</h6>
      <h2 class="text-h1 title">What Students Say</h2>
    </div>

    <div class="testimonial-slider reveal-fade-up" style="transition-delay: 0.2s;">
      <div class="testimonial-track" id="testimonialTrack">
        {testimonials.map((t) => (
          <div class="testimonial-slide">
            <div class="quote-icon">"</div>
            <p class="quote-text">{t.quote}</p>
            
            <div class="author-info">
              <div class="author-image">
                <img src={t.image} alt={t.name} loading="lazy" />
              </div>
              <div class="author-details">
                <h4 class="author-name">{t.name}</h4>
                <p class="author-type">{t.type}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="slider-controls">
        <button class="slider-btn prev-btn" aria-label="Previous testimonial">←</button>
        <button class="slider-btn next-btn" aria-label="Next testimonial">→</button>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 8rem 0;
    background-color: var(--color-bg);
  }

  .testimonials-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  .title {
    color: var(--color-primary);
  }

  .testimonial-slider {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    background-color: var(--color-surface);
    border-radius: var(--radius-2xl);
    padding: 3rem 1.5rem;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .testimonial-slider {
      padding: 5rem;
    }
  }

  .testimonial-track {
    display: flex;
    transition: transform 0.6s var(--ease-spring);
  }

  .testimonial-slide {
    flex: 0 0 100%;
    opacity: 0.3;
    transition: opacity 0.6s;
  }

  .testimonial-slide.is-active {
    opacity: 1;
  }

  .quote-icon {
    font-family: var(--font-display);
    font-size: 8rem;
    line-height: 0.5;
    color: var(--color-secondary);
    opacity: 0.3;
    margin-bottom: 1rem;
  }

  .quote-text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    color: var(--color-primary);
    line-height: 1.4;
    font-weight: 500;
    margin-bottom: 3rem;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .author-image {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
  }

  .author-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .author-name {
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .author-type {
    font-size: 0.9rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .slider-controls {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
  }

  .slider-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--color-primary);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .slider-btn:hover {
    background-color: var(--color-primary);
    color: var(--color-surface);
    border-color: var(--color-primary);
  }
</style>

<script>
  const initTestimonialSlider = () => {
    const track = document.getElementById('testimonialTrack');
    // Important: Scope selectors to the testimonials section to avoid conflicts
    const section = track?.closest('.testimonials-section');
    if (!track || !section) return;

    const slides = section.querySelectorAll('.testimonial-slide');
    const prevBtn = section.querySelector('.prev-btn');
    const nextBtn = section.querySelector('.next-btn');
    
    if (slides.length === 0) return;

    let currentIndex = 0;

    const updateSlider = () => {
      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active');
        }
      });
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
    };

    updateSlider(); // initial state

    prevBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex > 0) ? currentIndex - 1 : slides.length - 1;
      updateSlider();
    });

    nextBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex < slides.length - 1) ? currentIndex + 1 : 0;
      updateSlider();
    });
  };

  initTestimonialSlider();
</script>
