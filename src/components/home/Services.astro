---
import { services } from '../../data/services';
import MagneticButton from '../ui/MagneticButton.astro';
---

<section class="section services-section">
  <div class="container">
    <div class="services-header reveal-fade-up">
      <h6 class="subtitle">WHAT WE OFFER</h6>
      <h2 class="text-h1 title">In every chess position,<br/>there are opportunities</h2>
    </div>

    <div class="services-list">
      {services.map((service, index) => (
        <div class="service-row reveal-fade-up" style={`transition-delay: ${index * 0.1}s;`}>
          <div class="service-content">
            <div class="service-number">0{index + 1}</div>
            <div class="service-details">
              <h3 class="service-title">{service.name}</h3>
              <p class="service-desc">{service.description.split('\n')[0]}</p>
            </div>
          </div>
          <div class="service-image-preview">
            <img src={service.image} alt={service.name} />
          </div>
          <div class="service-action">
            <MagneticButton href={`/chess-academy-karnataka-india/#${service.id}`} text="Learn More" variant="outline" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 8rem 0;
  }

  .services-header {
    text-align: center;
    margin-bottom: 6rem;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }

  .title {
    color: var(--color-primary);
  }

  .services-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .service-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 3rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.4s var(--ease-out), padding 0.4s var(--ease-out);
    position: relative;
  }

  @media (min-width: 768px) {
    .service-row {
      grid-template-columns: 2fr 1fr auto;
      align-items: center;
      padding: 3rem 2rem;
    }

    .service-row:hover {
      background-color: var(--color-surface);
      border-radius: var(--radius-2xl);
      padding: 4rem 2rem;
      border-bottom-color: transparent;
      box-shadow: var(--shadow-sm);
    }
  }

  .service-content {
    display: flex;
    gap: 2rem;
  }

  .service-number {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .service-title {
    font-size: 2rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .service-desc {
    margin: 0;
    max-width: 500px;
  }

  .service-image-preview {
    display: none;
  }

  @media (min-width: 768px) {
    .service-image-preview {
      display: block;
      width: 150px;
      height: 100px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      opacity: 0;
      transform: translateX(-20px);
      transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
    }

    .service-image-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .service-row:hover .service-image-preview {
      opacity: 1;
      transform: translateX(0);
    }
  }

</style>
